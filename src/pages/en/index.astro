---
import PortfolioPage from '../../components/PortfolioPage.astro';
import { getCollection, getEntry } from 'astro:content';

const lang = 'en';
const profile = await getEntry('profile', lang);

if (!profile) {
	throw new Error(`Missing profile content for ${lang}`);
}

const experience = (await getCollection('experience', ({ data }) => data.lang === lang)).sort(
	(a, b) => a.data.order - b.data.order,
);
const projects = (await getCollection('projects', ({ data }) => data.lang === lang && !data.draft)).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<PortfolioPage lang={lang} profile={profile} experience={experience} projects={projects} />
