---
import SectionHeading from './SectionHeading.astro';
import type { CollectionEntry } from 'astro:content';
import type { UiText } from '../data/ui';

type ExperienceEntry = CollectionEntry<'experience'>;

interface Props {
	experience: ExperienceEntry[];
	t: UiText;
}

const { experience, t } = Astro.props;
---

<section id="experiencia" class="section">
	<SectionHeading num="03" title={t.expTitle} />
	<div class="timeline">
		{
			experience.map(({ data: job }) => (
				<div class="timeline-item reveal">
					<div class="timeline-marker">
						<span class="dot" />
						<span class="line" />
					</div>
					<div class="card job-card">
						<div class="job-header">
							<h3>{job.role}</h3>
							<span class="period">{job.period}</span>
						</div>
						<p class="company">{job.company} · {job.location} ({job.workMode})</p>
						<ul>
							{job.bullets.map((bullet) => (
								<li>{bullet}</li>
							))}
						</ul>
					</div>
				</div>
			))
		}
	</div>
</section>
