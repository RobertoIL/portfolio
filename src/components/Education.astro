---
import SectionHeading from './SectionHeading.astro';
import type { CollectionEntry } from 'astro:content';
import type { UiText } from '../data/ui';

type Education = CollectionEntry<'profile'>['data']['education'];

interface Props {
	education: Education;
	t: UiText;
}

const { education, t } = Astro.props;
---

<section id="educacion" class="section">
	<SectionHeading num="01" title={t.eduTitle} />
	<div class="card edu-card reveal">
		<div class="edu-info">
			<h3>{education.degree}</h3>
			<p>{education.institution} · {education.location}</p>
		</div>
		<span class="period-chip">{education.period}</span>
	</div>
</section>
