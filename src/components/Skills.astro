---
import SectionHeading from './SectionHeading.astro';
import type { CollectionEntry } from 'astro:content';
import type { UiText } from '../data/ui';

type Skills = CollectionEntry<'profile'>['data']['skills'];

interface Props {
	skills: Skills;
	t: UiText;
}

const { skills, t } = Astro.props;
---

<section id="habilidades" class="section">
	<SectionHeading num="02" title={t.skillsTitle} />
	<div class="skills-grid">
		<div class="card skills-card reveal">
			<p class="group-label">{t.skillsTech}</p>
			<div class="chip-list">
				{skills.technical.map((skill) => <span class="chip">{skill}</span>)}
			</div>
		</div>
		<div class="card skills-card stacked reveal">
			<div>
				<p class="group-label">{t.skillsMethods}</p>
				<div class="chip-list">
					{skills.methods.map((skill) => <span class="chip">{skill}</span>)}
				</div>
			</div>
			<div>
				<p class="group-label">{t.skillsLang}</p>
				<div class="chip-list">
					{skills.languages.map((skill) => <span class="chip">{skill}</span>)}
				</div>
			</div>
		</div>
	</div>
</section>
