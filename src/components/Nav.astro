---
import { Moon, Sun } from '@lucide/astro';
import type { Lang, Translations } from "../i18n";

interface Props {
	lang: Lang;
	t: Translations;
}

const { lang, t } = Astro.props;
const altLang = lang === "es" ? "en" : "es";
---

<nav class="site-nav">
	<div class="container">
		<a href="#descripcion" class="brand">RI</a>
		<div class="nav-links" id="nav-menu">
			<a href="#educacion" data-i18n="navEdu">{t.navEdu}</a>
			<a href="#habilidades" data-i18n="navSkills">{t.navSkills}</a>
			<a href="#experiencia" data-i18n="navExp">{t.navExp}</a>
			<a href="#proyectos" data-i18n="navProjects">{t.navProjects}</a>
			<a href="#contacto" data-i18n="navContact">{t.navContact}</a>
		</div>
		<div class="nav-actions">
			<button class="lang-toggle" type="button" data-lang-toggle data-lang={altLang}>{altLang.toUpperCase()}</button>
			<button class="theme-toggle" aria-label={t.themeToggleLabel} data-i18n-aria="themeToggleLabel">
				<Moon class="icon-moon" size={16} aria-hidden="true" />
				<Sun class="icon-sun" size={16} aria-hidden="true" />
			</button>
			<button
				class="nav-burger"
				aria-label={t.menuToggleLabel}
				data-i18n-aria="menuToggleLabel"
				aria-expanded="false"
				aria-controls="nav-menu"
			>
				<span></span>
				<span></span>
				<span></span>
			</button>
		</div>
	</div>
</nav>

<script>
	document.querySelector(".theme-toggle")?.addEventListener("click", () => {
		const root = document.documentElement;
		const theme = root.dataset.theme === "dark" ? "light" : "dark";
		root.dataset.theme = theme;
		localStorage.setItem("ri-portfolio-theme", theme);
	});

	const nav = document.querySelector(".site-nav");
	const burger = document.querySelector<HTMLButtonElement>(".nav-burger");

	burger?.addEventListener("click", () => {
		const open = nav?.classList.toggle("is-open") ?? false;
		burger.setAttribute("aria-expanded", String(open));
	});

	document.querySelectorAll(".nav-links a").forEach((link) => {
		link.addEventListener("click", () => {
			nav?.classList.remove("is-open");
			burger?.setAttribute("aria-expanded", "false");
		});
	});
</script>
