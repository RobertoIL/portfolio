---
import type { CollectionEntry } from "astro:content";
import type { UiText } from "../data/ui";

type Profile = CollectionEntry<"profile">["data"];

interface Props {
	profile: Profile;
	t: UiText;
}

const { profile, t } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container">
		<span>© {year} {profile.hero.name}</span>
	</div>
</footer>
