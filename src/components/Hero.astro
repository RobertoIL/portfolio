---
import { Download, MapPin } from '@lucide/astro';
import { contact, type Translations } from '../i18n';

interface Props {
	t: Translations;
}

const { t } = Astro.props;
---

<section id="descripcion" class="hero">
	<p class="hero-kicker reveal" data-i18n="heroKicker">{t.heroKicker}</p>
	<h1 class="reveal">Roberto Illesca</h1>
	<p class="hero-bio reveal" data-i18n="heroBio">{t.heroBio}</p>
	<div class="hero-actions reveal">
		<a href={contact.cvPath} download="CV Roberto Illesca.pdf" class="btn-primary">
			<Download size={16} aria-hidden="true" /><span data-i18n="cvButton">{t.cvButton}</span>
		</a>
		<a href="#contacto" class="btn-outline" data-i18n="heroContact">{t.heroContact}</a>
	</div>
	<div class="hero-meta reveal">
		<span><MapPin size={15} aria-hidden="true" />{contact.location}</span>
		<a href={`mailto:${contact.email}`}>{contact.email}</a>
	</div>
</section>
