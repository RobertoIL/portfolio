---
import { Download, MapPin } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';
import type { UiText } from '../data/ui';

type Profile = CollectionEntry<'profile'>['data'];

interface Props {
	profile: Profile;
	t: UiText;
}

const { profile, t } = Astro.props;
const { contact, hero } = profile;
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const cvHref = `${baseUrl}${contact.cvPath.replace(/^\//, '')}`;
---

<section id="descripcion" class="hero">
	<p class="hero-kicker reveal">{hero.kicker}</p>
	<h1 class="reveal">{hero.name}</h1>
	<p class="hero-bio reveal">{hero.bio}</p>
	<div class="hero-actions reveal">
		<a href={cvHref} download={`CV ${hero.name}.pdf`} class="btn-primary">
			<Download size={16} aria-hidden="true" /><span>{t.cvButton}</span>
		</a>
		<a href="#contacto" class="btn-outline">{t.heroContact}</a>
	</div>
	<div class="hero-meta reveal">
		<span><MapPin size={15} aria-hidden="true" />{contact.location}</span>
		<a href={`mailto:${contact.email}`}>{contact.email}</a>
	</div>
</section>
