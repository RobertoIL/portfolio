---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Education from './Education.astro';
import Skills from './Skills.astro';
import Experience from './Experience.astro';
import Projects from './Projects.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import type { CollectionEntry } from 'astro:content';
import { ui, type Lang } from '../data/ui';

type ProfileEntry = CollectionEntry<'profile'>;
type ExperienceEntry = CollectionEntry<'experience'>;
type ProjectEntry = CollectionEntry<'projects'>;

interface Props {
	lang: Lang;
	profile: ProfileEntry;
	experience: ExperienceEntry[];
	projects: ProjectEntry[];
}

const { lang, profile, experience, projects } = Astro.props;
const t = ui[lang];
---

<Layout lang={lang} title={profile.data.meta.title} description={profile.data.meta.description}>
	<Nav lang={lang} t={t} />
	<main class="container">
		<Hero profile={profile.data} t={t} />
		<Education education={profile.data.education} t={t} />
		<Skills skills={profile.data.skills} t={t} />
		<Experience experience={experience} t={t} />
		<Projects projects={projects} t={t} />
		<Contact contact={profile.data.contact} t={t} />
	</main>
	<Footer profile={profile.data} t={t} />
</Layout>
