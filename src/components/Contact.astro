---
import { ExternalLink, Mail, MapPin, Send } from '@lucide/astro';
import SectionHeading from './SectionHeading.astro';
import { contact, type Translations } from '../i18n';

interface Props {
	t: Translations;
}

const { t } = Astro.props;
const mailHref = `mailto:${contact.email}?subject=${encodeURIComponent(t.mailSubject)}`;
---

<section id="contacto" class="section contact">
	<SectionHeading num="05" title={t.contactTitle} i18nKey="contactTitle" />
	<div class="contact-info reveal">
		<p class="blurb" data-i18n="contactBlurb">{t.contactBlurb}</p>
		<a href={`mailto:${contact.email}`} class="contact-line">
			<span class="icon" aria-hidden="true"><Mail size={17} /></span>{contact.email}
		</a>
		<span class="contact-line">
			<span class="icon" aria-hidden="true"><MapPin size={17} /></span>{contact.location}
		</span>
		<a href={contact.linkedin} class="contact-line" target="_blank" rel="noreferrer">
			<span class="icon" aria-hidden="true"><ExternalLink size={17} /></span>LinkedIn
		</a>
		<a href={mailHref} class="btn-primary contact-cta" data-mail-cta data-email={contact.email}>
			<Send size={16} aria-hidden="true" /><span data-i18n="contactCta">{t.contactCta}</span>
		</a>
	</div>
</section>
