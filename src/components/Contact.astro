---
import SectionHeading from './SectionHeading.astro';
import { contact, type Translations } from '../i18n';

interface Props {
	t: Translations;
}

const { t } = Astro.props;
---

<section id="contacto" class="section contact">
	<SectionHeading num="05" title={t.contactTitle} />
	<div class="contact-grid">
		<div class="contact-info reveal">
			<p class="blurb">{t.contactBlurb}</p>
			<a href={`mailto:${contact.email}`} class="contact-line">
				<span class="icon" aria-hidden="true">✉</span>{contact.email}
			</a>
			<a href={contact.phoneHref} class="contact-line">
				<span class="icon" aria-hidden="true">✆</span>{contact.phone}
			</a>
			<span class="contact-line">
				<span class="icon" aria-hidden="true">📍</span>{contact.location}
			</span>
		</div>
		<form
			id="contact-form"
			class="card contact-form reveal"
			data-email={contact.email}
			data-subject-prefix={t.mailSubject}
		>
			<label>
				{t.formName}
				<input name="name" required />
			</label>
			<label>
				Email
				<input name="email" type="email" required />
			</label>
			<label>
				{t.formMessage}
				<textarea name="message" required rows="4"></textarea>
			</label>
			<button type="submit">{t.formSend}</button>
		</form>
	</div>
</section>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement | null;
	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		const data = new FormData(form);
		const name = String(data.get('name'));
		const email = String(data.get('email'));
		const message = String(data.get('message'));
		const subject = encodeURIComponent(form.dataset.subjectPrefix + name);
		const body = encodeURIComponent(`${message}\n\n— ${name} (${email})`);
		location.href = `mailto:${form.dataset.email}?subject=${subject}&body=${body}`;
	});
</script>
